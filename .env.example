# Django Core Settings
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# NVIDIA NIM AI Configuration
NIM_ENABLED=true
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
NIM_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NIM_TIMEOUT_SECONDS=20

# File Upload Settings (Default: 5MB in bytes)
UPLOAD_MAX_BYTES=5242880

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
